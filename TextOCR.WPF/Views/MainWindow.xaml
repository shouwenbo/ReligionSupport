<Window x:Class="TextOCR.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TextOCR.WPF.ViewModels"
        xmlns:converters="clr-namespace:TextOCR.WPF.Converters"
        mc:Ignorable="d"
        Title="智能视频字幕提取工具" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="智能视频字幕提取工具" 
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#673AB7"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    
                    <!-- Video Selection -->
                    <GroupBox Header="视频文件" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Button Command="{Binding SelectVideoCommand}"
                                    Height="40"
                                    Background="#673AB7"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Content="选择视频文件"/>
                            
                            <TextBlock Text="{Binding VideoPath}" 
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Foreground="Gray"
                                       FontSize="10"/>
                            
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding VideoInfo, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock>
                                    <Run Text="分辨率: "/>
                                    <Run Text="{Binding VideoInfo.Width, Mode=OneWay}"/>
                                    <Run Text=" × "/>
                                    <Run Text="{Binding VideoInfo.Height, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding VideoInfo.Fps, StringFormat='帧率: {0:F2} FPS'}"/>
                                <TextBlock Text="{Binding VideoInfo.Duration, StringFormat='时长: {0:hh\\:mm\\:ss}'}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- OCR Configuration -->
                    <GroupBox Header="识别配置" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            
                            <TextBlock Text="字幕区域高度 (像素)" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" 
                                        Minimum="20" Maximum="300" 
                                        Value="{Binding SubtitleHeight}"
                                        TickFrequency="10"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SubtitleHeight}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontWeight="Bold"/>
                            </Grid>

                            <CheckBox Content="从顶部截取" 
                                      IsChecked="{Binding FromTop}"
                                      Margin="0,15,0,0"/>

                            <TextBlock Text="帧间隔 (秒)" Margin="0,15,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" 
                                        Minimum="0.1" Maximum="2" 
                                        Value="{Binding FrameInterval}"
                                        TickFrequency="0.1"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding FrameInterval, StringFormat='{}{0:F1}'}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontWeight="Bold"/>
                            </Grid>

                            <TextBlock Text="预览时间点 (秒)" Margin="0,15,0,5"/>
                            <TextBox Text="{Binding PreviewSecond, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="时间范围 (可选)" Margin="0,15,0,5"/>
                            <TextBox Text="{Binding TimeRange, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Actions -->
                    <StackPanel>
                        <Button Command="{Binding PreviewCommand}"
                                Height="45"
                                Background="White"
                                BorderBrush="#673AB7"
                                BorderThickness="2"
                                Content="预览识别效果"
                                Margin="0,0,0,10"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"/>
                        
                        <Button Command="{Binding StartExtractionCommand}"
                                Height="50"
                                Background="#673AB7"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                FontWeight="Bold"
                                Content="开始提取字幕"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel - Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- Preview Area -->
                <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.6*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.4*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="视频帧预览" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                            <Image Source="{Binding FramePreview}" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Grid.Row="2" Text="字幕区域预览" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                            <Image Source="{Binding SubtitleRegionPreview}" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Grid.Row="4" Text="PaddleOCR 识别结果" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Border Grid.Row="5" BorderBrush="#2196F3" BorderThickness="2" Background="White" Padding="15" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding PaddleOcrResult}" 
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           Foreground="#333"
                                           LineHeight="24"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- Log Area -->
                <GroupBox Grid.Row="1" Header="日志信息" Background="White">
                    <TextBox Text="{Binding LogMessages}" 
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="NoWrap"
                             Background="#F8F8F8"
                             Padding="5"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"/>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" Padding="15,10" Margin="0,20,0,0" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center"
                           FontWeight="Medium"/>

                <ProgressBar Grid.Column="1"
                             Width="200"
                             Height="8"
                             Value="{Binding Progress}"
                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
