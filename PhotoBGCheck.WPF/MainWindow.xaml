<Window x:Class="PhotoBGCheck.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="证件照背景检测工具" 
        Height="700" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico">
    
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 文件夹选择区域 -->
        <GroupBox Grid.Row="0" Header="照片文件夹" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding SelectedFolderPath, Mode=TwoWay}" 
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>
                
                <Button Grid.Column="1" 
                        Content="选择文件夹" 
                        Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- 检测设置区域 -->
        <GroupBox Grid.Row="1" Header="检测设置" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 检测模式选择 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="检测模式:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                    
                    <RadioButton GroupName="DetectionMode" 
                                 Content="快速模式（适合大批量）" 
                                 IsChecked="{Binding IsFastMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,20,0"
                                 ToolTip="检测上方角落区域，速度极快，适合1000+张照片"/>
                    
                    <RadioButton GroupName="DetectionMode" 
                                 Content="AI智能模式（推荐）" 
                                 IsChecked="{Binding IsAIMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,20,0"
                                 ToolTip="AI人像识别后检测全背景，准确率更高（需要模型文件）"/>
                    
                    <TextBlock Text="{Binding AIStatusMessage}" 
                               Foreground="#999999" 
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowAIStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 参数设置 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="白色阈值:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding WhiteThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="RGB值大于此值才被视为白色 (0-255)"/>

                    <TextBlock Grid.Column="3" Text="白色占比:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4" 
                             Text="{Binding WhitePixelPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=P0}" 
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="背景中白色像素占比大于此值才算合格 (0-1)"/>

                    <Button Grid.Column="6" 
                            Content="开始检测" 
                            Command="{Binding StartCheckCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanStartCheck}"
                            Padding="25,8"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 检测进度和统计信息 -->
        <GroupBox Grid.Row="2" Header="检测结果统计" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 进度条 -->
                <ProgressBar Grid.Row="0" 
                             Height="20" 
                             Value="{Binding ProgressPercentage}" 
                             Minimum="0" Maximum="100"
                             Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 统计信息 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,0,20,0">
                        <Run Text="总数: "/>
                        <Run Text="{Binding TotalPhotoCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,0,20,0" Foreground="Green">
                        <Run Text="合格: "/>
                        <Run Text="{Binding QualifiedPhotoCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,0,20,0" Foreground="Red">
                        <Run Text="不合格: "/>
                        <Run Text="{Binding UnqualifiedPhotoCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,0,20,0">
                        <Run Text="合格率: "/>
                        <Run Text="{Binding QualificationRate, Mode=OneWay, StringFormat=P1}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 不合格照片展示区域 -->
        <GroupBox Grid.Row="3" Header="不合格照片列表" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="导出列表" 
                            Command="{Binding ExportUnqualifiedListCommand}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding HasUnqualifiedPhotos}"
                            Margin="0,0,10,0"/>
                    
                    <Button Content="在文件夹中打开" 
                            Command="{Binding OpenInExplorerCommand}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding HasSelectedFolder}"
                            Margin="0,0,10,0"/>
                </StackPanel>

                <!-- 照片列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding UnqualifiedPhotos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" 
                                        BorderThickness="1" 
                                        Margin="5" 
                                        Padding="8"
                                        Background="White"
                                        Width="200">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 缩略图 -->
                                        <Image Grid.Row="0" 
                                               Source="{Binding FilePath}" 
                                               Stretch="Uniform"
                                               Margin="0,0,0,8"/>

                                        <!-- 文件名 -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding FileName}" 
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>

                                        <!-- 检测详情 -->
                                        <TextBlock Grid.Row="2" 
                                                   FontSize="11" 
                                                   Foreground="#666666">
                                            <Run Text="白色占比: "/>
                                            <Run Text="{Binding WhitePixelPercentage, StringFormat=P1}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="3" 
                                                   FontSize="11" 
                                                   Foreground="#666666">
                                            <Run Text="背景亮度: "/>
                                            <Run Text="{Binding AverageBackgroundBrightness}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态提示 -->
                <TextBlock Grid.Row="1"
                           Text="暂无不合格照片"
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNoUnqualifiedPhotos, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
