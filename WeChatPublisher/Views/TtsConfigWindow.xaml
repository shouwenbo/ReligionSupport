<Window x:Class="WeChatPublisher.Views.TtsConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS &amp; 字幕 API 配置" Height="550" Width="650"
        Icon="Assets/app.ico" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="TTS 语音合成">
                <Grid Margin="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="API类型:"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbTtsType" Margin="0,2">
                                <ComboBoxItem Content="text-to-speech.cn (网页抓取)" Tag="WebScrape"/>
                                <ComboBoxItem Content="自定义 REST API" Tag="RestApi"/>
                                <ComboBoxItem Content="Azure Speech" Tag="Azure"/>
                            </ComboBox>

                            <Label Grid.Row="1" Grid.Column="0" Content="基础URL:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTtsBaseUrl" Margin="0,2"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Token获取端点:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtTtsTokenUrl" Margin="0,2"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Token正则:"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtTtsTokenRegex" Margin="0,2"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="生成端点:"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtTtsEndpoint" Margin="0,2"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="成功码字段:"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtTtsSuccessField" Margin="0,2"/>

                            <Label Grid.Row="6" Grid.Column="0" Content="成功码值:"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtTtsSuccessValue" Margin="0,2"/>

                            <Label Grid.Row="7" Grid.Column="0" Content="语言:"/>
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtTtsLanguage" Margin="0,2"/>

                            <Label Grid.Row="8" Grid.Column="0" Content="声音:"/>
                            <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtTtsVoice" Margin="0,2"/>

                            <Label Grid.Row="9" Grid.Column="0" Content="语速/音调:"/>
                            <Grid Grid.Row="9" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTtsRate" Grid.Column="0"/>
                                <Label Grid.Column="1" Content=" / "/>
                                <TextBox x:Name="TxtTtsPitch" Grid.Column="2"/>
                            </Grid>

                            <Label Grid.Row="10" Grid.Column="0" Content="比特率:"/>
                            <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtTtsBitrate" Margin="0,2"/>

                            <Label Grid.Row="11" Grid.Column="0" Content="额外参数JSON:"/>
                            <TextBox Grid.Row="11" Grid.Column="1" x:Name="TxtTtsExtraParams" Margin="0,2"
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <Button Grid.Row="12" Grid.Column="1" Content="测试朗读一段" Width="120"
                                    HorizontalAlignment="Left" Margin="0,6" Click="BtnTestTts_Click"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="字幕生成">
                <Grid Margin="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="API类型:"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbSubType" Margin="0,2">
                                <ComboBoxItem Content="text-to-speech.cn (网页抓取)" Tag="WebScrape"/>
                                <ComboBoxItem Content="自定义 REST API" Tag="RestApi"/>
                            </ComboBox>

                            <Label Grid.Row="1" Grid.Column="0" Content="基础URL:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSubBaseUrl" Margin="0,2"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Token获取端点:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSubTokenUrl" Margin="0,2"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Token正则:"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtSubTokenRegex" Margin="0,2"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="生成端点:"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtSubEndpoint" Margin="0,2"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="语言:"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtSubLanguage" Margin="0,2"/>

                            <Button Grid.Row="6" Grid.Column="1" Content="测试字幕生成" Width="120"
                                    HorizontalAlignment="Left" Margin="0,6" Click="BtnTestSub_Click"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="保存" Width="80" Style="{StaticResource PrimaryButton}"
                    Click="BtnSave_Click"/>
            <Button Content="取消" Width="80" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
