<Window x:Class="WeChatPublisher.Views.AiConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模型配置" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="文本生成 LLM">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="提供商:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbTextProvider" Margin="0,2"
                              SelectionChanged="CmbTextProvider_SelectionChanged">
                        <ComboBoxItem Content="DeepSeek" Tag="DeepSeek"/>
                        <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                        <ComboBoxItem Content="自定义" Tag="Custom"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="API 地址:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTextBaseUrl" Margin="0,2"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="API Key:"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PbTextApiKey" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="显示/隐藏" Width="75" Click="BtnShowHideKey_Click"/>
                        <Button Grid.Column="2" Content="测试" Width="55" Click="BtnTestTextAi_Click"/>
                    </Grid>

                    <Label Grid.Row="3" Grid.Column="0" Content="模型名称:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtTextModel" Margin="0,2"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="最大Token:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtTextMaxTokens" Margin="0,2"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="默认温度:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtTextTemperature" Margin="0,2"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="System Prompt:"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtTextSystemPrompt" Margin="0,2"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="图像生成 AI">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="提供商:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbImageProvider" Margin="0,2"
                              SelectionChanged="CmbImageProvider_SelectionChanged">
                        <ComboBoxItem Content="TokenHub (hy3-preview)" Tag="TokenHub"/>
                        <ComboBoxItem Content="混元 HunyuanImage" Tag="HunyuanImage"/>
                        <ComboBoxItem Content="DALL-E 兼容" Tag="DALLE"/>
                        <ComboBoxItem Content="自定义" Tag="Custom"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="模型名称:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtImageModel" Margin="0,2"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="API 地址:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtImageBaseUrl" Margin="0,2"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="API Key:"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PbImageApiKey" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="测试" Width="55" Click="BtnTestImageAi_Click"/>
                    </Grid>

                    <Label Grid.Row="4" Grid.Column="0" Content="默认尺寸:"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbImageSize" Margin="0,2">
                        <ComboBoxItem Content="1024x1024"/>
                        <ComboBoxItem Content="1792x1024"/>
                        <ComboBoxItem Content="1024x1792"/>
                    </ComboBox>

                    <Label Grid.Row="5" Grid.Column="0" Content="默认张数:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtImageCount" Margin="0,2" Text="1"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="保存" Width="80" Style="{StaticResource PrimaryButton}"
                    Click="BtnSave_Click"/>
            <Button Content="取消" Width="80" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
