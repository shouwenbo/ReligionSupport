<Window x:Class="WeChatPublisher.Views.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发布管理" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="待发布草稿">
                <DataGrid x:Name="DgDrafts" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="150"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                        <DataGridTextColumn Header="日期" Binding="{Binding CreatedAt}" Width="130"/>
                        <DataGridTextColumn Header="MediaId" Binding="{Binding MediaId}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="发布历史">
                <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding PublishType}" Width="60"/>
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="150"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="日期" Binding="{Binding CreatedAt}" Width="130"/>
                        <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="1" Header="文章预览" Padding="8" Margin="0,8,0,0">
            <TextBox x:Name="TbPreview" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" IsReadOnly="True" Height="100"
                     FontSize="13" FontFamily="Microsoft YaHei"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnRefresh" Content="刷新" Width="70" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnPublishDraft" Content="发布为草稿" Width="100" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="BtnPublishDraft_Click"/>
            <Button x:Name="BtnPublishNow" Content="立即群发" Width="90" Margin="10,0,0,0"
                    Click="BtnPublishNow_Click"/>
            <Button x:Name="BtnDelete" Content="删除" Width="60" Margin="10,0,0,0"
                    Style="{StaticResource DangerButton}" Click="BtnDelete_Click"/>
            <Button x:Name="BtnSaveLocal" Content="保存为docx" Width="100" Margin="10,0,0,0"
                    Click="BtnSaveLocal_Click"/>
        </StackPanel>
    </Grid>
</Window>
