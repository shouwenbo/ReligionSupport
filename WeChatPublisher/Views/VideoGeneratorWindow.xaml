<Window x:Class="WeChatPublisher.Views.VideoGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="短视频自动生成器" Height="680" Width="900"
        Icon="Assets/app.ico" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="文本内容">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="标题词1:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtVideoTitle1" Margin="0,2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="标题词2:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtVideoTitle2" Margin="0,2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="正文内容:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtVideoContent" Height="120"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="经文引用:"/>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtVerseRef" Grid.Column="0"/>
                            <Button Grid.Column="1" Content="查询" Width="55" Click="BtnVerseLookup_Click"/>
                        </Grid>

                        <Label Grid.Row="4" Grid.Column="0" Content="经文内容:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtVerseContent" Height="60"
                                 TextWrapping="Wrap" IsReadOnly="True" Margin="0,2"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="简介:"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtSummary" Margin="0,2"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="素材设置">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="背景视频:"/>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtVideoFolder" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="浏览..." Width="75" Click="BtnBrowseVideoFolder_Click"/>
                    </Grid>

                    <Label Grid.Row="1" Grid.Column="0" Content="背景音乐:"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMusicFolder" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="浏览..." Width="75" Click="BtnBrowseMusicFolder_Click"/>
                    </Grid>

                    <Label Grid.Row="2" Grid.Column="0" Content="封面图片:"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCoverPath" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="浏览..." Width="75" Click="BtnBrowseCover_Click"/>
                    </Grid>

                    <Label Grid.Row="3" Grid.Column="0" Content="额外秒数:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtExtraSeconds" Text="3" Width="60"
                             HorizontalAlignment="Left" Margin="0,2"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="输出目录:"/>
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOutputFolder" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="浏览..." Width="75" Click="BtnBrowseOutputFolder_Click"/>
                    </Grid>

                    <Label Grid.Row="5" Grid.Column="0" Content="TTS状态:"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TbTtsStatus" Text="未生成" Margin="0,2"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>

            <TabItem Header="生成日志">
                <TextBox x:Name="TbLog" IsReadOnly="True" VerticalScrollBarVisibility="Visible"
                         FontFamily="Consolas" FontSize="12" Background="#1e1e1e" Foreground="#d4d4d4"
                         TextWrapping="Wrap" Margin="4"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnGenerateTts" Content="生成TTS" Width="80" Height="36"
                    Click="BtnGenerateTts_Click"/>
            <Button x:Name="BtnGenerateSubtitle" Content="生成字幕" Width="80" Height="36"
                    Margin="10,0,0,0" Click="BtnGenerateSubtitle_Click"/>
            <Button x:Name="BtnGenerateVideo" Content="&#x25B6; 合成视频" Width="100" Height="36"
                    Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="BtnGenerateVideo_Click"/>
            <TextBlock x:Name="TbVideoProgress" Text="" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
