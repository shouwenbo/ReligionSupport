<Window x:Class="WeChatPublisher.Views.VideoGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="短视频自动生成器" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态 -->
        <Border Grid.Row="0" Background="#1a1a2e" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TbSourceSummary" Text="准备就绪" Foreground="#a0c4ff" FontSize="13"/>
                <TextBlock Grid.Column="1" x:Name="TbActiveAccount" Text="" Foreground="#7ec8a0"
                           FontSize="12" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 MCP 素材 -->
            <GroupBox Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="#2c3e50"
                      BorderBrush="#e0e0e0" Padding="4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MCP 素材" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbMaterialCount" Text="" FontSize="10" Foreground="#999"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="BtnRefreshMaterials" Content="🔄 刷新" Width="70" Height="24"
                            FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,4"
                            Click="BtnRefreshMaterials_Click"/>
                    <ListBox Grid.Row="1" x:Name="LbMaterials" Background="White"
                             BorderThickness="0" FontSize="12" HorizontalContentAlignment="Stretch"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,3"/>
                                <EventSetter Event="MouseDoubleClick" Handler="LbMaterials_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,6,0" Click="CheckBox_Click"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SourceIcon}" FontSize="13"
                                               VerticalAlignment="Center" Width="20"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- 右侧 随机经文 -->
            <GroupBox Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="#2c3e50"
                      BorderBrush="#e0e0e0" Padding="4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="随机经文" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbVerseCount" Text="" FontSize="10" Foreground="#999"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="BtnRefreshVerses" Content="🔄 刷新" Width="70" Height="24"
                            FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,4"
                            Click="BtnRefreshVerses_Click"/>
                    <ListBox Grid.Row="1" x:Name="LbVerses" Background="White"
                             BorderThickness="0" FontSize="12" HorizontalContentAlignment="Stretch"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,3"/>
                                <EventSetter Event="MouseDoubleClick" Handler="LbVerses_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,6,0" Click="CheckBox_Click"/>
                                    <TextBlock Grid.Column="1" Text="📖" FontSize="13"
                                               VerticalAlignment="Center" Width="20"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 视频参数 -->
        <Border Grid.Row="2" x:Name="PanelParams" Background="#f8f9fa" CornerRadius="4"
                Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="标题词1" FontSize="10" Foreground="#999"/>
                    <TextBox x:Name="TxtVideoTitle1" FontSize="12" Margin="0,2,0,4"/>
                    <TextBlock Text="标题词2" FontSize="10" Foreground="#999"/>
                    <TextBox x:Name="TxtVideoTitle2" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="额外秒数" FontSize="10" Foreground="#999"/>
                        <TextBox x:Name="TxtExtraSeconds" Text="3" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="视频风格" FontSize="10" Foreground="#999"/>
                        <ComboBox x:Name="CmbStyle" FontSize="11" Margin="0,2,0,0">
                            <ComboBoxItem Content="天父书信" IsSelected="True"/><ComboBoxItem Content="感悟分享"/>
                        </ComboBox>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 按钮 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" x:Name="BtnStart" Content="▶ 生成视频文案" Width="150" Height="38"
                    Style="{StaticResource PrimaryButton}" FontSize="14" Click="BtnStart_Click"/>
        </Grid>

        <!-- 输出区 -->
        <Border Grid.Row="4" x:Name="PanelOutput" Visibility="Collapsed" Margin="0,4,0,0" Padding="8"
                BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TbOutput" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
                         FontSize="14" BorderThickness="0"/>
                <Border Grid.Row="1" Grid.Column="1" Background="#e8ecf1" CornerRadius="3" Padding="4" Margin="4,0,0,0">
                    <TextBox x:Name="TbProgress" IsReadOnly="True" Background="Transparent"
                             FontFamily="Consolas" FontSize="9" BorderThickness="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="等待开始..."/>
                </Border>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BtnStop" Content="停止" Width="60" Height="26" Visibility="Collapsed"
                            Margin="0,0,6,0" Click="BtnStop_Click"/>
                    <Button x:Name="BtnLearn" Content="学习风格" Width="76" Height="26" Margin="0,0,6,0"
                            FontSize="10" Style="{StaticResource PrimaryButton}" Background="#6c5ce7"
                            Click="BtnLearn_Click"/>
                    <Button x:Name="BtnSaveDraft" Content="保存草稿" Width="76" Height="26" Margin="0,0,6,0"
                            Click="BtnSaveDraft_Click"/>
                    <Button x:Name="BtnPublish" Content="发布视频文案" Width="110" Height="26"
                            Style="{StaticResource PrimaryButton}" Click="BtnPublish_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
