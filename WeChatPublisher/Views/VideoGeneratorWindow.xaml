<Window x:Class="WeChatPublisher.Views.VideoGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="短视频自动生成器" Height="600" Width="850" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1a1a2e" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TbSourceSummary" Text="短视频生成器" Foreground="#a0c4ff" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbActiveAccount" Text="" Foreground="#7ec8a0" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbSelectedCount" Text="" Foreground="#7ec8a0" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnSelectMaterials" Content="📋 选择素材" Width="100" Height="26"
                        FontSize="11" Click="BtnSelectMaterials_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" x:Name="PanelParams" Background="#f8f9fa" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="标题词1" FontSize="10" Foreground="#999"/>
                    <TextBox x:Name="TxtVideoTitle1" FontSize="12" Margin="0,2,0,4"/>
                    <TextBlock Text="标题词2" FontSize="10" Foreground="#999"/>
                    <TextBox x:Name="TxtVideoTitle2" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="风格" FontSize="10" Foreground="#999"/>
                    <ComboBox x:Name="CmbStyle" FontSize="11" Margin="0,2,0,0">
                        <ComboBoxItem Content="天父书信" IsSelected="True"/><ComboBoxItem Content="感悟分享"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="2" x:Name="BtnStart" Content="▶ 生成视频文案" Width="150" Height="38"
                Style="{StaticResource PrimaryButton}" FontSize="14" HorizontalAlignment="Center"
                Click="BtnStart_Click" Margin="0,0,0,8"/>

        <Border Grid.Row="3" x:Name="PanelOutput" Visibility="Collapsed" Padding="8"
                BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" x:Name="TbOutput" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Visible" FontSize="14" BorderThickness="0"/>
                <Border Grid.Row="0" Grid.Column="1" Background="#e8ecf1" CornerRadius="3" Padding="4" Margin="4,0,0,0">
                    <TextBox x:Name="TbProgress" IsReadOnly="True" Background="Transparent"
                             FontFamily="Consolas" FontSize="9" BorderThickness="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="等待开始..."/>
                </Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BtnStop" Content="停止" Width="60" Height="26" Visibility="Collapsed" Margin="0,0,6,0" Click="BtnStop_Click"/>
                    <Button x:Name="BtnLearn" Content="学习风格" Width="76" Height="26" Margin="0,0,6,0" FontSize="10"
                            Style="{StaticResource PrimaryButton}" Background="#6c5ce7" Click="BtnLearn_Click"/>
                    <Button x:Name="BtnSaveDraft" Content="保存草稿" Width="76" Height="26" Margin="0,0,6,0" Click="BtnSaveDraft_Click"/>
                    <Button x:Name="BtnPublish" Content="发布到公众号" Width="110" Height="26"
                            Style="{StaticResource PrimaryButton}" Click="BtnPublish_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
