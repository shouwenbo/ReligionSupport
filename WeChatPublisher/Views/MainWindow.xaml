<Window x:Class="WeChatPublisher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微讯创作发布工具"
        Icon="Assets/app.ico"
        Height="700" Width="960" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="公众号 &amp; 视频号自动发布工具" FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,12" Foreground="#2c3e50"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="BtnArticle" Content="文章生成器" Width="140" Height="50"
                    Margin="0,0,10,8" FontSize="13" Click="BtnArticle_Click"/>
            <Button x:Name="BtnVideo" Content="视频生成器" Width="140" Height="50"
                    Margin="0,0,10,8" FontSize="13" Click="BtnVideo_Click"/>
            <Button x:Name="BtnPublish" Content="发布管理" Width="140" Height="50"
                    Margin="0,0,10,8" FontSize="13" Click="BtnPublish_Click"/>
            <Button x:Name="BtnAgent" Content="Agent 任务" Width="140" Height="50"
                    Margin="0,0,10,8" FontSize="13" Click="BtnAgent_Click"/>
        </WrapPanel>

        <GroupBox Grid.Row="2" Header="系统配置快捷入口" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <Button x:Name="BtnAiConfig" Content="AI 模型配置" Width="110" Height="32"
                        Margin="0,0,8,0" Click="BtnAiConfig_Click"/>
                <Button x:Name="BtnTtsConfig" Content="TTS / 字幕配置" Width="120" Height="32"
                        Margin="0,0,8,0" Click="BtnTtsConfig_Click"/>
                <Button x:Name="BtnWeChatConfig" Content="公众号配置" Width="110" Height="32"
                        Margin="0,0,8,0" Click="BtnWeChatConfig_Click"/>
                <Button x:Name="BtnMcpConfig" Content="MCP 资源管理" Width="110" Height="32"
                        Margin="0,0,8,0" Click="BtnMcpConfig_Click"/>
                <Button x:Name="BtnSensitiveWord" Content="敏感词知识库" Width="110" Height="32"
                        Margin="0,0,8,0" Click="BtnSensitiveWord_Click"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="系统健康状态" Padding="6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="ElAiHealth" Width="12" Height="12" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TbAiHealth" Text="AI" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse x:Name="ElTtsHealth" Width="12" Height="12" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TbTtsHealth" Text="TTS" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse x:Name="ElWechatHealth" Width="12" Height="12" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TbWechatHealth" Text="公众号" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Ellipse x:Name="ElMcpHealth" Width="12" Height="12" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TbMcpHealth" Text="MCP资源" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="最近任务" Padding="8">
            <DataGrid x:Name="DgTasks" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MouseDoubleClick="DgTasks_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Binding="{Binding CreatedAt}" Width="130"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TaskType}" Width="60"/>
                    <DataGridTextColumn Header="标题" Binding="{Binding SourceTitle}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="轮次" Binding="{Binding TotalRounds}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StatusBar Grid.Row="5" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TbStatus" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TbConfigStatus" Text="请先配置 AI 和公众号"
                           Foreground="OrangeRed"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
