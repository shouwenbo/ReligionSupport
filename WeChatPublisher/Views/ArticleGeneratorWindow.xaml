<Window x:Class="WeChatPublisher.Views.ArticleGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文章自动生成器" Height="680" Width="960"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Source & Config -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="输入源" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="RbMcp" Content="MCP 资源" IsChecked="True"
                                 Checked="RbMcp_Checked" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbManual" Content="手动输入" Margin="0,0,10,0"
                                 Grid.Row="1" Checked="RbManual_Checked"/>

                    <ComboBox x:Name="CmbMcpResource" Grid.Row="2" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="AI 与敏感词配置" Padding="8" Margin="0,8,0,0">
                <TextBlock x:Name="TbAiStatus" Text="未配置" Foreground="OrangeRed"/>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="文章参数" Padding="8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="风格:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbStyle" Margin="0,2">
                        <ComboBoxItem Content="温情生活型"/><ComboBoxItem Content="诗意感悟型"/>
                        <ComboBoxItem Content="故事分享型"/><ComboBoxItem Content="哲理思辨型"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="AI温度:"/>
                    <Slider Grid.Row="1" Grid.Column="1" x:Name="SldTemperature" Minimum="0" Maximum="1"
                            Value="0.7" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElementName=SldTemperature, Path=Value, StringFormat={}{0:F1}}"
                               HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="最大轮次:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMaxRounds" Text="3" Width="40"
                             HorizontalAlignment="Left" Margin="0,2"/>

                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="CbManualReview" Content="每轮完成后暂停，等待手动确认"
                              Margin="0,6,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Manual input (hidden by default) -->
            <GroupBox Grid.Row="3" x:Name="GbManualInput" Header="手动输入" Padding="8"
                      Visibility="Collapsed" Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="标题:"/>
                        <TextBox Grid.Row="0" x:Name="TxtTitle" Margin="40,0,0,4"/>
                        <Label Grid.Row="1" Content="简介:"/>
                        <TextBox Grid.Row="1" x:Name="TxtDesc" Height="40" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="40,0,0,4"/>
                        <Label Grid.Row="2" Content="经文:"/>
                        <TextBox Grid.Row="2" x:Name="TxtVerse" Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="40,0,0,4"/>
                        <Label Grid.Row="3" Content="内容:"/>
                        <TextBox Grid.Row="3" x:Name="TxtContent" Height="120" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="40,0,0,4"/>
                        <Label Grid.Row="4" Content="标签:"/>
                        <TextBox Grid.Row="4" x:Name="TxtTags" Margin="40,0,0,4"/>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnStart" Content="&#x25B6; 开始生成" Width="120" Height="40"
                        Style="{StaticResource PrimaryButton}" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Content="&#x23F8; 停止" Width="80" Height="40"
                        Margin="10,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
                <TextBlock x:Name="TbProgress" Text="" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="13" Foreground="#2c3e50"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- Right: Output & Preview -->
        <Grid Grid.Column="2" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="生成进度" Padding="8">
                <ProgressBar x:Name="PbProgress" Height="20" Minimum="0" Maximum="100"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="最终输出预览" Padding="8" Margin="0,8,0,0">
                <TabControl>
                    <TabItem Header="AI生成">
                        <TextBox x:Name="TbOutput" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                 FontSize="13" FontFamily="Microsoft YaHei"/>
                    </TabItem>
                    <TabItem Header="净化后">
                        <TextBox x:Name="TbSanitized" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                 FontSize="13" FontFamily="Microsoft YaHei"/>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnSaveDraft" Content="&#x1F4BE; 保存草稿" Width="100" Height="36"
                        Click="BtnSaveDraft_Click"/>
                <Button x:Name="BtnPublish" Content="&#x1F4E4; 发布到公众号" Width="120" Height="36"
                        Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="BtnPublish_Click"/>
                <Button x:Name="BtnCopy" Content="&#x1F4CB; 复制" Width="80" Height="36"
                        Margin="10,0,0,0" Click="BtnCopy_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
