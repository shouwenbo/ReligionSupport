<Window x:Class="WeChatPublisher.Views.ArticleGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文章自动生成器" Height="720" Width="960"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 智能摘要栏 -->
        <Border Grid.Row="0" Background="#1a1a2e" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TbSourceSummary" Text="正在扫描素材..." Foreground="#a0c4ff"
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbAiSummary" Text="" Foreground="#7ec8a0"
                               FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnToggleSettings" Content="高级设置 ▾"
                        Background="#2d2d5a" Foreground="#ccc" Width="100" Height="28"
                        FontSize="11" Click="BtnToggleSettings_Click"/>
            </Grid>
        </Border>

        <!-- 高级设置面板（默认折叠） -->
        <Border Grid.Row="1" x:Name="PanelSettings" Visibility="Collapsed"
                Background="#f8f9fa" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="AI 温度" FontSize="11" Foreground="#666"/>
                        <Slider x:Name="SldTemperature" Minimum="0" Maximum="1" Value="0.7"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="TbTempValue" Text="0.7" FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="最大迭代轮次" FontSize="11" Foreground="#666"/>
                        <TextBox x:Name="TxtMaxRounds" Text="3" Width="50" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="文章风格" FontSize="11" Foreground="#666"/>
                        <ComboBox x:Name="CmbStyle" Margin="0,2,0,0">
                            <ComboBoxItem Content="AI自动选择" IsSelected="True"/>
                            <ComboBoxItem Content="温情生活型"/><ComboBoxItem Content="诗意感悟型"/>
                            <ComboBoxItem Content="故事叙事型"/><ComboBoxItem Content="深度思考型"/>
                            <ComboBoxItem Content="暖心鼓励型"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MCP源:" FontSize="11" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMcpResource"/>
                </Grid>
                <CheckBox x:Name="CbManualReview" Content="生成后需人工审核再定稿" Margin="0,6,0,0" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 主按钮区 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="BtnStart" Content="▶ 开始生成" Width="180" Height="42"
                    Style="{StaticResource PrimaryButton}" FontSize="15"
                    HorizontalAlignment="Center" Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="停止" Width="80" Height="42"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center" Click="BtnStop_Click"/>
        </Grid>

        <!-- 输出区 -->
        <TabControl Grid.Row="3" x:Name="TabOutput" Margin="0,0,0,8">
            <TabItem Header="AI生成">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <TextBlock x:Name="TbProgress" Text="等待开始..." FontSize="12"
                                   Foreground="#888" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="PbProgress" Width="200" Height="10"
                                     Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"/>
                        <Button x:Name="BtnLearn" Content="审核完成 ✓" Width="100" Height="26"
                                FontSize="11" Margin="20,0,0,0"
                                Style="{StaticResource PrimaryButton}" Background="#6c5ce7"
                                Click="BtnLearn_Click" ToolTip="对比修改后学习你的写作风格"/>
                        <TextBlock x:Name="TbLearnCount" Text="" FontSize="11"
                                   Foreground="#6c5ce7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="TbOutput" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
                             FontSize="14" BorderThickness="0"/>
                </Grid>
            </TabItem>
            <TabItem Header="净化后">
                <TextBox x:Name="TbSanitized" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
                         FontSize="14" BorderThickness="0"/>
            </TabItem>
        </TabControl>

        <!-- 底部操作栏 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnSaveDraft" Content="保存草稿" Width="90" Click="BtnSaveDraft_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnCopy" Content="复制到剪贴板" Width="110" Click="BtnCopy_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnPublish" Content="发布到公众号" Width="110"
                    Style="{StaticResource PrimaryButton}" Click="BtnPublish_Click"/>
        </StackPanel>
    </Grid>
</Window>
