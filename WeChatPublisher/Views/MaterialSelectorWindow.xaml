<Window x:Class="WeChatPublisher.Views.MaterialSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择素材" Height="600" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="勾选你需要的素材和经文，作为 AI 生成的参考" FontSize="12"
                   Foreground="#666" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="#2c3e50"
                      BorderBrush="#e0e0e0" Padding="4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MCP 素材" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbMaterialCount" Text="" FontSize="10" Foreground="#999"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="BtnRefreshMaterials" Content="🔄 刷新" Width="70" Height="22"
                                FontSize="10" Margin="12,0,0,0" Click="BtnRefreshMaterials_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <ListBox x:Name="LbMaterials" Background="White" BorderThickness="0" FontSize="12"
                         HorizontalContentAlignment="Stretch" MaxHeight="380">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <EventSetter Event="MouseDoubleClick" Handler="LbMaterials_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SourceIcon}" FontSize="13"
                                           VerticalAlignment="Center" Width="20"/>
                                <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="#2c3e50"
                      BorderBrush="#e0e0e0" Padding="4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="随机经文" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbVerseCount" Text="" FontSize="10" Foreground="#999"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="BtnRefreshVerses" Content="🔄 刷新" Width="70" Height="22"
                                FontSize="10" Margin="12,0,0,0" Click="BtnRefreshVerses_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <ListBox x:Name="LbVerses" Background="White" BorderThickness="0" FontSize="12"
                         HorizontalContentAlignment="Stretch" MaxHeight="380">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <EventSetter Event="MouseDoubleClick" Handler="LbVerses_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="📖" FontSize="13"
                                           VerticalAlignment="Center" Width="20"/>
                                <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确认选择" Width="100" Height="32" Style="{StaticResource PrimaryButton}"
                    Click="BtnConfirm_Click"/>
            <Button Content="取消" Width="70" Height="32" Margin="8,0,0,0" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
