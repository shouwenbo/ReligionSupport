<Window x:Class="WeChatPublisher.Views.WeChatConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信公众号配置" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="AppID:" FontWeight="Bold"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAppId" Margin="0,4"/>

            <Label Grid.Row="1" Grid.Column="0" Content="AppSecret:" FontWeight="Bold"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PbAppSecret" Grid.Column="0"/>
                <Button Grid.Column="1" Content="验证" Width="75" Click="BtnVerify_Click"/>
                <Button Grid.Column="2" Content="显示" Width="75" Click="BtnShowSecret_Click"/>
            </Grid>

            <Label Grid.Row="2" Grid.Column="0" Content="API 服务器:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtApiBaseUrl" Text="https://api.weixin.qq.com" Margin="0,4"/>

            <Label Grid.Row="3" Grid.Column="0" Content="发布模式:"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                <CheckBox x:Name="CbPublishAsDraft" Content="默认发布为草稿 (不直接群发)" IsChecked="True"/>
                <CheckBox x:Name="CbAutoSanitize" Content="敏感词自动净化后再发布" IsChecked="True" Margin="0,4,0,0"/>
            </StackPanel>

            <Label Grid.Row="4" Grid.Column="0" Content="默认标签 (空格分隔):"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtDefaultTags" Margin="0,4"/>

            <Label Grid.Row="5" Grid.Column="0" Content="图片素材文件夹:"/>
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtImageFolder" Grid.Column="0"/>
                <Button Grid.Column="1" Content="浏览..." Width="75" Click="BtnBrowseImageFolder_Click"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="80" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button Content="取消" Width="80" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
