<Window x:Class="WeChatPublisher.Views.WeChatConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公众号 &amp; 视频号多账号管理" Height="600" Width="780"
        Icon="Assets/app.ico" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 账号列表 -->
        <DataGrid Grid.Row="0" x:Name="DgAccounts" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DgAccounts_SelectionChanged"
                  Height="180" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="健康" Binding="{Binding HealthDisplay}" Width="50"/>
                <DataGridTextColumn Header="名称" Binding="{Binding AccountName}" Width="120"/>
                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="100"/>
                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="160"/>
                <DataGridTextColumn Header="当前" Binding="{Binding ActiveDisplay}" Width="60"/>
                <DataGridTextColumn Header="上次检测" Binding="{Binding LastHealthCheck}" Width="130"/>
                <DataGridTemplateColumn Header="操作" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="切换" Width="45" Tag="{Binding Id}" Click="BtnSwitch_Click"/>
                                <Button Content="自测" Width="45" Tag="{Binding Id}" Margin="4,0,0,0"
                                        Click="BtnHealthCheck_Click"/>
                                <Button Content="删除" Width="45" Tag="{Binding Id}" Margin="4,0,0,0"
                                        Style="{StaticResource DangerButton}" Click="BtnDeleteAccount_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 编辑面板 -->
        <GroupBox Grid.Row="1" Header="添加/编辑账号" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="账号名称:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAccountName" Margin="0,2"/>

                <Label Grid.Row="1" Grid.Column="0" Content="平台类型:"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbPlatform" Margin="0,2">
                    <ComboBoxItem Content="公众号" Tag="OfficialAccount" IsSelected="True"/>
                    <ComboBoxItem Content="视频号" Tag="VideoChannel"/>
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="0" Content="AppID:"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtAppId" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="扫码获取" Width="95" Margin="4,0,0,0"
                            Click="BtnScanQr_Click"/>
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Content="AppSecret:"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="55"/><ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PbAppSecret" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="显示" Width="50" Margin="4,0,0,0" Click="BtnShowSecret_Click"/>
                    <Button Grid.Column="2" Content="打开后台" Width="50" Margin="4,0,0,0" Click="BtnOpenAdmin_Click"
                            ToolTip="在浏览器中打开公众号后台，方便查找AppSecret"/>
                </Grid>

                <Label Grid.Row="4" Grid.Column="0" Content="发布模式:"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                    <CheckBox x:Name="CbPublishAsDraft" Content="默认发布为草稿" IsChecked="True"/>
                    <CheckBox x:Name="CbAutoSanitize" Content="敏感词自动净化后发布" IsChecked="True"/>
                </StackPanel>

                <Label Grid.Row="5" Grid.Column="0" Content="默认标签:"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtDefaultTags" Margin="0,2"/>

                <Label Grid.Row="6" Grid.Column="0" Content="健康状态:"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Ellipse x:Name="ElHealth" Width="16" Height="16" Fill="Gray"/>
                    <TextBlock x:Name="TbHealthMsg" Text="未检测" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbHealthTime" Text="" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存账号" Width="90" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button Content="自测全部" Width="80" Margin="10,0,0,0" Click="BtnHealthCheckAll_Click"/>
            <Button Content="关闭" Width="60" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
