<Window x:Class="WeChatPublisher.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="素材详情" Height="500" Width="700" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TbDetailSource" Text="" FontSize="14" FontWeight="Bold" Foreground="#2c3e50"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="TbDetailMeta" Text="" FontSize="11" Foreground="#999"
                   Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" x:Name="TbDetailContent" TextWrapping="Wrap" IsReadOnly="True"
                 VerticalScrollBarVisibility="Visible" FontSize="14" BorderBrush="#e0e0e0"
                 Background="White"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="复制全文" Width="90" Height="28" Click="BtnCopy_Click"/>
            <Button Content="关闭" Width="70" Height="28" Margin="8,0,0,0" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
