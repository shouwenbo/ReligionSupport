<Window x:Class="WeChatPublisher.Views.SensitiveWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="敏感词知识库管理" Height="620" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAdd" Content="添加规则" Width="80" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="删除选中" Width="80" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}" Click="BtnDelete_Click"/>
            <Button x:Name="BtnImport" Content="导入CSV" Width="80" Margin="8,0,0,0" Click="BtnImport_Click"/>
            <Button x:Name="BtnExport" Content="导出CSV" Width="80" Margin="8,0,0,0" Click="BtnExport_Click"/>
            <Button x:Name="BtnRefresh" Content="刷新" Width="60" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DgWords" AutoGenerateColumns="False"
                  SelectionMode="Single" SelectionChanged="DgWords_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="源词" Binding="{Binding SourceWord}" Width="80"/>
                <DataGridTextColumn Header="替换词" Binding="{Binding ReplacementWords}" Width="180"/>
                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="70"/>
                <DataGridTextColumn Header="严格度" Binding="{Binding StrictLevel}" Width="50"/>
                <DataGridTextColumn Header="策略" Binding="{Binding StrategyDisplay}" Width="90"/>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="编辑规则" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/><ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="源词:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSourceWord" Margin="0,2"/>

                <Label Grid.Row="0" Grid.Column="2" Content="类别:"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CmbCategory" Margin="0,2">
                    <ComboBoxItem Content="称谓"/><ComboBoxItem Content="人名"/>
                    <ComboBoxItem Content="概念"/><ComboBoxItem Content="组织"/>
                    <ComboBoxItem Content="场所"/><ComboBoxItem Content="行为"/>
                    <ComboBoxItem Content="活动"/><ComboBoxItem Content="物品"/>
                    <ComboBoxItem Content="用语"/><ComboBoxItem Content="自定义"/>
                </ComboBox>

                <Label Grid.Row="1" Grid.Column="0" Content="替换词:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtReplacements" Margin="0,2"/>

                <Label Grid.Row="1" Grid.Column="2" Content="严格度:"/>
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CmbStrictLevel" Margin="0,2">
                    <ComboBoxItem Content="建议替换 (0)" Tag="0"/>
                    <ComboBoxItem Content="强制替换 (1)" Tag="1" IsSelected="True"/>
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="0" Content="处理策略:"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbStrategy" Margin="0,2">
                    <ComboBoxItem Content="直接替换" Tag="0"/>
                    <ComboBoxItem Content="AI意境改写" Tag="1"/>
                    <ComboBoxItem Content="AI自动抉择" Tag="2" IsSelected="True"/>
                </ComboBox>

                <Label Grid.Row="3" Grid.Column="0" Content="改写示例:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtRewriteExamples"
                         Margin="0,2" Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                         ToolTip="每行一条: 原文 → 改写后"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="BtnSaveRule" Content="保存规则" Width="80"
                        Style="{StaticResource PrimaryButton}" Click="BtnSaveRule_Click"/>

                <Label Content="   测试文本:" Margin="20,0,0,0"/>
                <TextBox x:Name="TxtTestInput" Width="300" Height="24"/>
                <Button x:Name="BtnTest" Content="扫描" Width="60" Margin="4,0,0,0" Click="BtnTest_Click"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Label x:Name="LblTestResult" Content="扫描结果将显示在这里" Foreground="Gray"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
